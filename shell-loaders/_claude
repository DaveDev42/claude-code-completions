#compdef claude
# Thin loader for claude-code-completions.
# On first use (or when claude version changes), regenerates completion into cache.
# Falls back to the static pre-generated completion shipped with the package.

# Capture the loader's own path at SOURCE time, before _claude() is defined.
# Inside the function body, $0 is the function name ("_claude"), not the
# file path — `${(%):-%N}` is the zsh-blessed way to get the source file.
typeset -g _CLAUDE_LOADER_DIR="${${(%):-%N}:A:h}"

_claude() {
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/claude-code-completions"
  local meta_file="$cache_dir/.claude-meta"
  local claude_path
  claude_path="$(command -v claude 2>/dev/null)"
  local version cache_file

  # A cache file is considered usable only if it starts with the zsh
  # completion sentinel `#compdef claude`. -s (size > 0) alone passes a
  # stray 1-byte newline or any partial / corrupt file, which would then
  # source as nothing and leave _claude undefined ("command not found:
  # _claude" on every tab). Matching the sentinel is fast (one read) and
  # generator-format-stable (every shipped zsh completion must start with
  # #compdef to be recognised by zsh's compinit at all).
  _claude_cache_ok() {
    [[ -s "$1" ]] || return 1
    local first
    IFS= read -r first < "$1" 2>/dev/null || return 1
    [[ "$first" == "#compdef claude"* ]]
  }

  # Fast path: if claude binary path+mtime matches a recorded sentinel, reuse
  # the cached completion without spawning `claude --version` (saves ~tens of
  # ms per shell). Falls through to the slow path on any mismatch.
  if [[ -n "$claude_path" && -r "$meta_file" ]]; then
    local mtime
    if [[ "$OSTYPE" == darwin* ]]; then
      mtime="$(stat -f %m "$claude_path" 2>/dev/null)"
    else
      mtime="$(stat -c %Y "$claude_path" 2>/dev/null)"
    fi
    local meta_path meta_mtime meta_version
    IFS=$'\t' read -r meta_path meta_mtime meta_version < "$meta_file"
    if [[ "$meta_path" == "$claude_path" && "$meta_mtime" == "$mtime" && -n "$meta_version" ]]; then
      cache_file="$cache_dir/_claude-$meta_version"
      # Sentinel-checked: a 0-byte file or a stray 1-byte newline (or any
      # partial / corrupt write) falls through to the slow path and gets
      # regenerated. Sourcing such a file would leave _claude undefined
      # and produce "command not found: _claude" on every tab.
      if _claude_cache_ok "$cache_file"; then
        unfunction _claude 2>/dev/null
        source "$cache_file"
        _claude "$@"
        return
      fi
    fi
  fi

  version="$(command claude --version 2>/dev/null | tr -d ' ()/' )"
  [[ -z "$version" ]] && version="unknown"
  cache_file="$cache_dir/_claude-$version"

  # Sentinel-checked so a 0-byte file, a stray 1-byte newline, or any
  # partially-written cache from a prior crash is treated as missing and
  # regenerated. Plain `-s` would let a 1-byte file through and the
  # loader would source garbage forever.
  if ! _claude_cache_ok "$cache_file"; then
    # Locate the generator (installed alongside this loader by Homebrew)
    # Priority: $CLAUDE_COMPLETIONS_BIN env var, then common prefixes.
    local gen="${CLAUDE_COMPLETIONS_BIN:-}"
    if [[ -z "$gen" ]]; then
      for candidate in \
        "$(brew --prefix 2>/dev/null)/bin/claude-code-completions" \
        "/opt/homebrew/bin/claude-code-completions" \
        "/usr/local/bin/claude-code-completions"; do
        [[ -x "$candidate" ]] && { gen="$candidate"; break; }
      done
    fi

    mkdir -p "$cache_dir"
    # zsh loader installs at <prefix>/share/zsh/site-functions/_claude;
    # static fallback lives at <prefix>/share/claude-code-completions/.
    # That's three directories up. Use $_CLAUDE_LOADER_DIR captured at
    # source time — $0 inside the function is just the function name.
    local static_file="$_CLAUDE_LOADER_DIR/../../../share/claude-code-completions/_claude.static"
    # Write to a temp file then atomically rename, so a partial / failed
    # generate never leaves a corrupt cache file sitting where the next
    # shell would source it. We require BOTH a successful exit AND a
    # non-empty file: a generator that crashes after writing some bytes
    # (SIGKILL, broken pipe, etc.) would otherwise leave a syntactically
    # broken file that passes `-s` and then fails to source.
    local tmp_file="$cache_file.$$.tmp"
    local gen_ok=0
    if [[ -x "$gen" ]]; then
      "$gen" generate --shell zsh > "$tmp_file" 2>/dev/null && gen_ok=1
    fi
    # If the generator failed, was missing, or produced nothing usable,
    # fall back to the static shipped completion.
    if [[ $gen_ok -eq 0 || ! -s "$tmp_file" ]]; then
      rm -f "$tmp_file"
      [[ -f "$static_file" ]] && cp "$static_file" "$tmp_file"
    fi
    # Sentinel-check the tmp before promoting: a generator that emitted
    # a single byte before SIGKILL would pass `-s` but produce a cache
    # file that fails to source.
    if _claude_cache_ok "$tmp_file"; then
      mv -f "$tmp_file" "$cache_file"
    else
      rm -f "$tmp_file"
    fi

    # Prune stale caches from previous claude versions
    local stale
    for stale in "$cache_dir"/_claude-*(N); do
      [[ "$stale" != "$cache_file" ]] && rm -f "$stale"
    done
  fi

  # Update the fast-path sentinel so the next shell skips `claude --version`.
  if [[ -n "$claude_path" ]]; then
    local mtime
    if [[ "$OSTYPE" == darwin* ]]; then
      mtime="$(stat -f %m "$claude_path" 2>/dev/null)"
    else
      mtime="$(stat -c %Y "$claude_path" 2>/dev/null)"
    fi
    [[ -n "$mtime" ]] && printf '%s\t%s\t%s\n' "$claude_path" "$mtime" "$version" > "$meta_file"
  fi

  # Source the cached completion. It defines _claude (same function name),
  # overriding this loader, so subsequent invocations skip the loader entirely.
  # Sentinel-checked so a corrupt cache falls through to _default rather
  # than being sourced and leaving _claude undefined.
  if _claude_cache_ok "$cache_file"; then
    unfunction _claude 2>/dev/null
    source "$cache_file"
    _claude "$@"
  else
    _default "$@"
  fi
}

_claude "$@"
