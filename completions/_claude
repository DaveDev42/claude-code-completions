__claude_run_source() {
  local subcmd=$1
  local bin="${CLAUDE_COMPLETIONS_BIN:-claude-code-completions}"
  command "$bin" "$subcmd" 2>/dev/null
}

__claude_agents() {
  local -a entries
  entries=(${(f)"$(__claude_run_source list-agents)"})
  local -a values
  local line name desc
  for line in $entries; do
    name="${line%%$'\t'*}"
    desc="${line#*$'\t'}"
    [[ -z "$name" ]] && continue
    if [[ -n "$desc" && "$desc" != "$name" ]]; then
      values+=("${name}:${desc}")
    else
      values+=("$name")
    fi
  done
  _describe -t agents 'agent' values
}

__claude_sessions() {
  local -a entries
  entries=(${(f)"$(__claude_run_source list-sessions)"})
  local -a values
  local line uuid desc
  for line in $entries; do
    uuid="${line%%$'\t'*}"
    desc="${line#*$'\t'}"
    [[ -z "$uuid" ]] && continue
    if [[ -n "$desc" ]]; then
      values+=("${uuid}:${desc}")
    else
      values+=("$uuid")
    fi
  done
  _describe -t sessions 'session' values
}

